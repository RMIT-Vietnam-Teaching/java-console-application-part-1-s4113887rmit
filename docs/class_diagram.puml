enum UserRole {
    ADMIN
    OFFICER
    CUSTOMER
}

enum UserStatus {
    ACTIVE
    INACTIVE
}

enum ClaimStatus {
    NEW
    PROCESSING
    DONE
    --
    +fromString(String) : ClaimStatus {static}
}

enum MembershipTier {
    STANDARD
    SILVER
    GOLD
    PLATINUM
    --
    +BASE_COPAY_RATE : double = 0.30 {static}
    -discountRate : double
    --
    +getDiscountRate() : double
    +getEffectiveCopayRate() : double
    +fromString(String) : MembershipTier {static}
    +computeTier(double) : MembershipTier {static}
}


' ---------- inheritance ----------
User          <|-- Admin
User          <|-- ClaimsOfficer
User          <|-- Customer
Customer      <|-- PolicyHolder
Customer      <|-- Dependent

' ---------- associations ----------
User             "1"  -->  "1"      UserRole        : role >
User             "1"  -->  "1"      UserStatus      : status >
Customer         "1"  -->  "0..1"   InsuranceCard   : insuranceCard >
Customer         "1"  ..>  "1"      MembershipTier  : getMembershipTier() >
PolicyHolder     "1"  *--  "0..*"   Dependent       : dependents >
Dependent        "1"  ..>  "1"      PolicyHolder    : parentPolicyHolderId >
Claim            "*"  -->  "1"      ClaimStatus     : status >
Claim            "*"  -->  "1"      Customer        : insuredPersonId >
Claim            "*"  -->  "1"      InsuranceCard   : cardNumber >

note bottom of MembershipTier
  Effective co-pay = BASE_COPAY_RATE * (1 - discount)
  STANDARD 30.0% | SILVER 28.5% | GOLD 27.0% | PLATINUM 25.5%
end note

@enduml

@startuml ClaimShield_Service_Layer
title ClaimShield - 2. Service / Persistence Layer

interface Manageable {
    +add(T) : boolean throws ClaimShieldException {abstract}
    +update(T) : boolean throws ClaimShieldException {abstract}
    +delete(String) : boolean {abstract}
    +getById(String) : T {abstract}
    +getAll() : List<T> {abstract}
}

interface UserManageable extends Manageable<User> {
    +authenticate(String, String) : User {abstract}
}

interface CustomerManageable extends Manageable<Customer> {
    +filterByType(String) : List<Customer> {abstract}
    +filterByParentPolicyHolder(String) : List<Customer> {abstract}
    +searchByName(String) : List<Customer> {abstract}
}

interface CardManageable extends Manageable<InsuranceCard> {
    +getByCardHolderId(String) : InsuranceCard {abstract}
    +getByPolicyOwnerId(String) : List<InsuranceCard> {abstract}
    +filterExpiringBefore(LocalDateTime) : List<InsuranceCard> {abstract}
}

interface ClaimManageable extends Manageable<Claim> {
    +filterByStatus(ClaimStatus) : List<Claim> {abstract}
    +filterByDateRange(LocalDateTime, LocalDateTime) : List<Claim> {abstract}
    +filterByPolicyHolderFamily(String) : List<Claim> {abstract}
    +filterByCardNumber(String) : List<Claim> {abstract}
}

